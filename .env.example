AUTOVISION_DEPLOYMENT_MODE=on-premise
AUTOVISION_HOMEPAGE_MODE=demo
AUTOVISION_PUBLIC_DEMO_ENABLED=true
AUTOVISION_PUBLIC_DEMO_DAILY_LIMIT=100
# Vision-capable Bedrock Converse model; also requires task-role permissions.
AUTOVISION_VISION_MODEL_ID=
AUTOVISION_ROOT_USER=root
AUTOVISION_ROOT_PASSWORD=autovision-local-change-me
AUTOVISION_SESSION_SECRET=autovision-local-session-secret-change-me
AWS_REGION=us-east-1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
# Usage-based overage (SaaS only). Off by default; test in Stripe test mode first.
# Metered overage price IDs from: AUTOVISION_IMAGE_OVERAGE_UNIT_CENTS=<cents> node --env-file=.env devops/stripe/setup-plans.mjs --apply
STRIPE_IMAGE_OVERAGE_PRICE_ID=
STRIPE_AI_OVERAGE_PRICE_ID=
AUTOVISION_USAGE_EXPORT=disabled
# Versioned AI credit weights and included credits per plan; empty leaves AI usage unpriced. Example only, not approved prices:
# AUTOVISION_AI_CREDIT_WEIGHTS_JSON={"version":"v1","included_credits":{"starter":1000,"scale":10000},"models":{"us.amazon.nova-lite-v1:0":{"input_per_1k":1,"output_per_1k":4}}}
# Seconds between worker usage alert/export cycles (minimum 30).
AUTOVISION_USAGE_CYCLE_SECONDS=300
# Buyer-facing Marketplace listing URL (https://aws.amazon.com/marketplace/pp/prodview-...)
AUTOVISION_MARKETPLACE_URL=

# Default detection labels when no organization setting or detection_labels is given.
# COCO labels use OpenCV YOLOX; package/smoke/fire are advisory Nova grounding, not safety alarms.
AUTOVISION_AI_DETECTIONS=person,dog,cat,bird,car,bicycle,motorcycle,truck,package
# Optional operator-approved model registry; verify region, image/tool support and IAM permissions.
# AUTOVISION_AI_MODELS_JSON=[{"id":"scene_detail","label":"Detailed scene model","modelId":"YOUR_APPROVED_MODEL_OR_PROFILE","skills":["scene","package","activity"]}]

